rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsBusiness(businessId) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    // Recommended storage layout:
    // businesses/{businessId}/...
    match /businesses/{businessId}/{allPaths=**} {
      allow read, write: if ownsBusiness(businessId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
