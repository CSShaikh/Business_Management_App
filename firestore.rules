rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsBusiness(businessId) {
      return signedIn()
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    match /businesses/{businessId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow read, delete: if ownsBusiness(businessId);

      allow update: if ownsBusiness(businessId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerId == request.auth.uid;

      match /{subcollection}/{documentId} {
        allow read, write: if ownsBusiness(businessId);
      }
    }

    // Deny every path that is not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
