rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================================================
    // AUTHENTICATION
    // ==================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // ==================================================
    // BUSINESS OWNERSHIP
    // ==================================================

    function isBusinessOwner(businessId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/businesses/$(businessId)
        )
        && get(
          /databases/$(database)/documents/businesses/$(businessId)
        ).data.ownerId == request.auth.uid;
    }


    // ==================================================
    // USERS
    // ==================================================

    match /users/{userId} {

      allow create: if isSignedIn()
        && userId == request.auth.uid;

      allow read, update, delete: if isSignedIn()
        && userId == request.auth.uid;
    }


    // ==================================================
    // BUSINESSES
    // ==================================================

    match /businesses/{businessId} {

      // ------------------------------------------------
      // CREATE BUSINESS
      // ------------------------------------------------

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;


      // ------------------------------------------------
      // READ BUSINESS
      // ------------------------------------------------

      allow read: if isBusinessOwner(businessId);


      // ------------------------------------------------
      // UPDATE BUSINESS
      // ------------------------------------------------

      allow update: if isBusinessOwner(businessId)
        && request.resource.data.ownerId
            == resource.data.ownerId;


      // ------------------------------------------------
      // DELETE BUSINESS
      // ------------------------------------------------

      allow delete: if isBusinessOwner(businessId);


      // ==================================================
      // PRODUCTS
      // ==================================================

      match /products/{productId} {

        allow read, write: if isBusinessOwner(
          businessId
        );
      }


      // ==================================================
      // CUSTOMERS
      // ==================================================

      match /customers/{customerId} {

        allow read, write: if isBusinessOwner(
          businessId
        );
      }


      // ==================================================
      // SUPPLIERS
      // ==================================================

      match /suppliers/{supplierId} {

        allow read, write: if isBusinessOwner(
          businessId
        );
      }


      // ==================================================
      // PURCHASES
      // ==================================================

      match /purchases/{purchaseId} {

        allow read, write: if isBusinessOwner(
          businessId
        );
      }


      // ==================================================
      // SALES
      // ==================================================

      match /sales/{saleId} {

        allow read, write: if isBusinessOwner(
          businessId
        );
      }


      // ==================================================
      // CUSTOMER PAYMENTS
      // ==================================================

      match /payments/{paymentId} {

        allow read, write: if isBusinessOwner(
          businessId
        );
      }


      // ==================================================
      // SUPPLIER PAYMENTS
      // ==================================================

      match /supplierPayments/{paymentId} {

        allow read, write: if isBusinessOwner(
          businessId
        );
      }


      // ==================================================
      // EXPENSES
      // ==================================================

      match /expenses/{expenseId} {

        allow read, write: if isBusinessOwner(
          businessId
        );
      }


      // ==================================================
      // STOCK TRANSACTIONS
      // ==================================================

      match /stock_transactions/{transactionId} {

        allow read, write: if isBusinessOwner(
          businessId
        );
      }


      // ==================================================
      // LEDGER TRANSACTIONS
      // ==================================================

      match /ledger_transactions/{transactionId} {

        allow read, write: if isBusinessOwner(
          businessId
        );
      }
    }
  }
}